---
import fs from 'node:fs';
import { site, interests } from '../data/site';
import { getWork } from '../data/work';
// Component Imports
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import PolaroidRow from '../components/PolaroidRow.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
import Timeline from '../components/Timeline.astro';
import Toolbox from '../components/Toolbox.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getWork();

// Add your photo at public/assets/portrait.jpg and it will appear in the hero.
const hasPortrait = fs.existsSync('public/assets/portrait.jpg');

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class:list={['hero', { 'no-portrait': !hasPortrait }]}>
				<Hero
					title="Hi, I’m Adam"
					tagline={[
						'I’m a senior software engineer who specializes in iOS and cares about building consumer-grade apps that are a joy to use.',
						'I’m a polyglot at heart, with experience across iOS, Android, web, backend, and cloud infrastructure, and I’m happiest wherever the hard problem is.',
						`I’m based in ${site.location}.`,
					]}
					align="start"
				/>

				{
					hasPortrait && (
						<img
							alt={site.name}
							width="480"
							height="620"
							src="/assets/portrait.jpg"
							data-enter
							style="--enter-delay: 250ms"
						/>
					)
				}
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section id="experience" class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4" data-reveal>
					<h3>Experience</h3>
					<p>From flight software at NASA to apps people use every day.</p>
				</header>

				<div class="gallery">
					<Timeline>
						{
							projects.map((project) => (
								<li data-reveal>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Timeline>
				</div>
			</section>

			<section class="section">
				<header class="section-header stack gap-2 lg:gap-4" data-reveal>
					<h3>Skills</h3>
					<p>The languages and tools I reach for most.</p>
				</header>

				<div class="gallery">
					<Toolbox />
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4" data-reveal>
					<h3>Outside work</h3>
					<p>When I’m away from the keyboard, this is where you’ll find me.</p>
				</header>

				<div class="gallery">
					<PolaroidRow
						entrance="toss"
						photos={interests.map(({ label, photo }) => ({ caption: label, photo }))}
					/>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}


	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
		}

		.hero.no-portrait {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}


		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.gallery {
			grid-area: gallery;
		}
	}
</style>
