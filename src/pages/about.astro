---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`About | ${site.name}`} description={`About ${site.name}`}>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="About" tagline="A little more about me and how I got here." />

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I’m a senior iOS engineer at Toast on the Core Platform team for Toast Local, the
						consumer app that connects diners with their local restaurants. Before Toast, I built iOS
						apps at Fliff and Addepar, and I started my career as a software engineer at Capital One.
					</p>
					<p>
						Over eight years, much of it in fintech, I’ve found I care as much about how teams build
						as what they ship. I’ve done platform and developer-experience work along the way, and
						I’m always looking for ways to help engineers ship good apps faster.
					</p>
					<p>
						I recently served as acting engineering manager at Toast, and I still help lead the team:
						roadmap planning, skip-level syncs with product and design, and owning large projects end
						to end.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>BS in Computer Science, James Madison University</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Outside work</h2>
				<div class="content">
					<p>
						I live in {site.location}. When I’m not working, I’m usually running, out on a mountain
						bike trail, or playing guitar.
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
