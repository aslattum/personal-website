---
interface Props {
	title: string;
	/** One paragraph, or several shown with space between them. */
	tagline?: string | string[];
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
const paragraphs = tagline ? [tagline].flat() : [];
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h1 class="title" data-enter>{title}</h1>
		{
			paragraphs.length > 0 && (
				<div class="taglines stack gap-4">
					{paragraphs.map((p, i) => (
						<p class="tagline" data-enter style={`--enter-delay: ${120 + i * 110}ms`}>
							{p}
						</p>
					))}
				</div>
			)
		}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline {
		max-width: 37ch;
		margin-inline: auto;
	}

	.taglines {
		gap: 1.25rem;
	}

	.taglines .tagline {
		max-width: 46ch;
	}

	.title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}

		.title {
			font-size: var(--text-5xl);
		}
	}
</style>
