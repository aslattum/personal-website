---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title = `${site.name}, ${site.role}`,
	description = site.description,
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,700;1,400&family=Rubik:wght@500;600&family=Caveat:wght@500&display=swap"
	rel="stylesheet"
/>
<meta name="color-scheme" content="dark" />
<script is:inline>
	// Enable scroll and entrance animations before first paint, unless the
	// visitor prefers reduced motion. Without JS, nothing is hidden.
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.documentElement.classList.add('motion-ready');
	}
</script>
