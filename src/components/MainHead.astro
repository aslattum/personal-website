---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title = `${site.name}, ${site.role}`,
	description = site.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
---

<meta charset="utf-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<link rel="canonical" href={canonicalURL} />

<!-- Link previews (LinkedIn, iMessage, Slack, X, etc.) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,700;1,400&family=Rubik:wght@500;600&family=Caveat:wght@500&display=swap"
	rel="stylesheet"
/>
<meta name="color-scheme" content="dark" />
<script is:inline>
	// Enable scroll and entrance animations before first paint, unless the
	// visitor prefers reduced motion. Without JS, nothing is hidden.
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.documentElement.classList.add('motion-ready');
	}
</script>
