---
import Polaroid from './Polaroid.astro';

interface Props {
	photos: { caption: string; photo?: string }[];
	/** How the photos animate in: tossed onto the table, or bursting out from the center. */
	entrance?: 'toss' | 'burst';
}

const { photos, entrance = 'burst' } = Astro.props;
---

<ul class:list={['polaroids', entrance]} data-reveal style={`--n: ${photos.length}`}>
	{
		photos.map(({ caption, photo }, i) => (
			<li style={`--i: ${i}`}>
				<Polaroid caption={caption} photo={photo} />
			</li>
		))
	}
</ul>

<style>
	/* A single overlapping row of instant photos. Each one gets its own tilt
	   and nudge, and pops forward on hover. */
	.polaroids {
		display: flex;
		justify-content: center;
		list-style: none;
		padding: 1.5rem 0 2.5rem;
	}

	.polaroids > li {
		--tilt: 0deg;
		--shift: 0rem;

		position: relative;
		flex: 1 1 0;
		min-width: 0;
		max-width: 18rem;
		transform: translateY(var(--shift)) rotate(var(--tilt));
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	/* Overlap each photo onto the one before it. */
	.polaroids > li + li {
		margin-left: -12%;
	}

	.polaroids > li:nth-child(4n + 1) {
		--tilt: -6deg;
	}
	.polaroids > li:nth-child(4n + 2) {
		--tilt: 4deg;
		--shift: 1rem;
	}
	.polaroids > li:nth-child(4n + 3) {
		--tilt: -3deg;
		--shift: -0.5rem;
	}
	.polaroids > li:nth-child(4n + 4) {
		--tilt: 6deg;
		--shift: 0.75rem;
	}

	.polaroids > li:hover,
	.polaroids > li:active {
		z-index: 1;
		transform: translateY(calc(var(--shift) - 1.25rem)) rotate(0deg) scale(1.12);
	}

	@media (prefers-reduced-motion: reduce) {
		.polaroids > li {
			transition: none;
		}
	}

	@media (min-width: 50em) {
		.polaroids {
			padding-block: 2.5rem 4rem;
		}

		.polaroids > li + li {
			margin-left: -2.5rem;
		}
	}

	/* Entrance animations, played once when the row scrolls into view. */
	:global(.motion-ready) .polaroids[data-reveal] {
		opacity: 1;
		transform: none;
	}

	:global(.motion-ready) .polaroids:not(.is-visible) > li {
		opacity: 0;
	}

	/* Burst: the photos start as a small stack in the middle of the row and
	   burst out to their places. */
	:global(.motion-ready) .burst.is-visible > li {
		/* Distance from this photo's spot to the center of the row, in photo
		   widths (each photo overlaps the previous one by roughly 14%). */
		--from-center: calc(((var(--n) - 1) / 2 - var(--i)) * 86%);

		animation: burst 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2) backwards;
		animation-delay: calc(450ms + var(--i) * 40ms);
	}

	@keyframes burst {
		from {
			opacity: 0;
			transform: translateX(var(--from-center)) translateY(1.5rem) rotate(0deg) scale(0.3);
		}
		30% {
			opacity: 1;
		}
	}

	/* Toss: each photo is thrown onto the "table" one at a time, flying in
	   spinning, skidding slightly past its spot, and settling into its tilt. */
	.toss > li:nth-child(4n + 1) {
		--throw-x: -60vw;
		--throw-y: 18rem;
		--throw-r: -55deg;
	}
	.toss > li:nth-child(4n + 2) {
		--throw-x: 45vw;
		--throw-y: 26rem;
		--throw-r: 40deg;
	}
	.toss > li:nth-child(4n + 3) {
		--throw-x: -35vw;
		--throw-y: 30rem;
		--throw-r: 65deg;
	}
	.toss > li:nth-child(4n + 4) {
		--throw-x: 65vw;
		--throw-y: 14rem;
		--throw-r: -45deg;
	}

	:global(.motion-ready) .toss.is-visible > li {
		animation: toss 0.8s cubic-bezier(0.15, 0.7, 0.3, 1) backwards;
		animation-delay: calc(300ms + var(--i) * 180ms);
	}

	@keyframes toss {
		from {
			opacity: 0;
			transform: translate(var(--throw-x), var(--throw-y)) rotate(var(--throw-r)) scale(1.15);
		}
		15% {
			opacity: 1;
		}
		/* Skid a touch past the landing spot. */
		75% {
			transform: translate(calc(var(--throw-x) * -0.03), calc(var(--shift) - 0.25rem))
				rotate(calc(var(--tilt) - var(--throw-r) * 0.08)) scale(1);
		}
	}
</style>
