---
import Polaroid from './Polaroid.astro';

interface Props {
	photos: { caption: string; photo?: string }[];
}

const { photos } = Astro.props;
---

<ul class="polaroids" data-reveal>
	{
		photos.map(({ caption, photo }, i) => (
			<li style={`--i: ${i}`}>
				<Polaroid caption={caption} photo={photo} />
			</li>
		))
	}
</ul>

<style>
	/* A single overlapping row of instant photos. Each one gets its own tilt
	   and nudge, and pops forward on hover. */
	.polaroids {
		display: flex;
		justify-content: center;
		list-style: none;
		padding: 1.5rem 0 2.5rem;
	}

	.polaroids > li {
		--tilt: 0deg;
		--shift: 0rem;

		position: relative;
		flex: 1 1 0;
		min-width: 0;
		max-width: 18rem;
		transform: translateY(var(--shift)) rotate(var(--tilt));
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	/* Overlap each photo onto the one before it. */
	.polaroids > li + li {
		margin-left: -12%;
	}

	.polaroids > li:nth-child(4n + 1) {
		--tilt: -6deg;
	}
	.polaroids > li:nth-child(4n + 2) {
		--tilt: 4deg;
		--shift: 1rem;
	}
	.polaroids > li:nth-child(4n + 3) {
		--tilt: -3deg;
		--shift: -0.5rem;
	}
	.polaroids > li:nth-child(4n + 4) {
		--tilt: 6deg;
		--shift: 0.75rem;
	}

	.polaroids > li:hover,
	.polaroids > li:active {
		z-index: 1;
		transform: translateY(calc(var(--shift) - 1.25rem)) rotate(0deg) scale(1.12);
	}

	@media (prefers-reduced-motion: reduce) {
		.polaroids > li {
			transition: none;
		}
	}

	/* With motion enabled, the photos are "dealt" onto the table one at a time
	   when the row scrolls into view, then settle into their tilts. */
	:global(.motion-ready) .polaroids[data-reveal] {
		opacity: 1;
		transform: none;
	}

	:global(.motion-ready) .polaroids:not(.is-visible) > li {
		opacity: 0;
	}

	:global(.motion-ready) .polaroids.is-visible > li {
		animation: deal 0.75s cubic-bezier(0.2, 0.8, 0.3, 1.15) backwards;
		animation-delay: calc(var(--i) * 140ms);
	}

	@keyframes deal {
		from {
			opacity: 0;
			transform: translateY(-5rem) rotate(calc(var(--tilt) * -2.5)) scale(1.12);
		}
	}

	@media (min-width: 50em) {
		.polaroids {
			padding-block: 2.5rem 4rem;
		}

		.polaroids > li + li {
			margin-left: -2.5rem;
		}
	}
</style>
