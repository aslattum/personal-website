---
import type { CollectionEntry } from 'astro:content';
import { years } from '../data/work';
import LinkPill from './LinkPill.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { data, id } = project;
---

<article class:list={['card', { 'has-img': data.img }]}>
	{
		data.img ? (
			<>
				<a class="title card-link" href={`/work/${id}/`}>{data.company}</a>
				<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
			</>
		) : (
			<div class="text">
				<p class="years">{years(project)}</p>
				<p class="company">
					<a class="card-link" href={`/work/${id}/`}>{data.company}</a>
				</p>
				<p class="desc">{data.description}</p>
				{(data.appStore || data.github) && (
					<div class="links">
						{data.appStore && <LinkPill href={data.appStore} icon="apple-logo" label="App Store" />}
						{data.github && <LinkPill href={data.github} icon="github-logo" label="GitHub" />}
					</div>
				)}
			</div>
		)
	}
</article>

<style>
	.card {
		position: relative;
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		min-height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition:
			box-shadow var(--theme-transition),
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		border-color: var(--accent-regular);
		transform: translateY(-4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover {
			transform: none;
		}
	}

	/* The company name links to the role page; stretch its hit area over the
	   whole card so any click opens it (except the App Store link above it). */
	.card-link {
		color: inherit;
		text-decoration: none;
	}

	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--accent-dark);
		outline-offset: 2px;
	}

	.links {
		display: flex;
		gap: 0.5rem;
		padding-top: 1rem;
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.text {
		grid-area: 1 / 1 / 3 / 3;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.5rem;
		color: var(--gray-200);
	}

	.years {
		font-size: var(--text-sm);
		color: var(--accent-dark);
	}

	.company {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		line-height: 1.1;
	}


	.desc {
		margin-top: auto;
		padding-top: 1rem;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-base);
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.card {
			min-height: 18rem;
			border-radius: 1.5rem;
		}

		.card.has-img {
			height: 22rem;
		}

		.title {
			border-radius: 0.9375rem;
		}

		.text {
			padding: 2.5rem;
		}

		.company {
			font-size: var(--text-3xl);
		}
	}
</style>
